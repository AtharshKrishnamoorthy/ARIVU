# ══════════════════════════════════════════════════════════════════════════════
#  ARIVU — Environment Configuration Template
#  ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in the values you need.
#  Only set the keys relevant to your chosen providers and integrations.
#  NEVER commit your actual .env file — it is gitignored.
# ══════════════════════════════════════════════════════════════════════════════


# ── LLM Provider Selection ────────────────────────────────────────────────────
# Which provider Arivu uses to run the text-to-SQL pipeline.
# Supported values: groq | openai | anthropic | gemini | deepseek | huggingface | qwen | ollama
ARIVU_LLM_PROVIDER=groq

# Which model to use on the selected provider.
# Leave blank to use the provider's recommended default.
# Examples: llama-3.3-70b-versatile | gpt-5.4 | claude-sonnet-4-6 | gemini-3.1-flash
ARIVU_LLM_MODEL=


# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Set ONLY the key for your chosen ARIVU_LLM_PROVIDER above.
# All others can be left blank.

# Groq  (fastest inference, recommended default)
# Get key: https://console.groq.com
GROQ_API_KEY=

# OpenAI  (GPT-5.4 series, GPT-4o, GPT-4-turbo)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic  (Claude 4.6 Sonnet, Claude 4.5 Haiku, Claude 4.8 Opus)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini  (Gemini 3.1 Pro, Gemini 3.1 Flash, Gemini 3.5 Flash)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek  (deepseek-v4-flash, deepseek-v4-pro, deepseek-r1)
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# HuggingFace Inference API  (Mistral-Small-4, Qwen3.6, or any public HF model)
# Get key: https://huggingface.co/settings/tokens
HF_API_KEY=

# Alibaba Qwen via DashScope  (qwen3.7-max, qwen3.7-plus, qwen3.6-plus)
# Get key: https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=

# Ollama  (local, zero cost — no key needed)
# Set this only if Ollama is NOT running on the default localhost port.
OLLAMA_BASE_URL=http://localhost:11434


# ── Thesys C1 (Generative Chart UI) ──────────────────────────────────────────
# Required for the AI-generated chart/visualization feature in the dashboard.
# Get key: https://thesys.ai
THESYS_API_KEY=


# ── Memory Backend ────────────────────────────────────────────────────────────
# Where Arivu stores session history, traces, and RLHF signals.
# Options: sqlite (default, zero config) | redis (for multi-instance deployments)
ARIVU_MEMORY_BACKEND=sqlite

# Path to the SQLite database file (only used when ARIVU_MEMORY_BACKEND=sqlite).
# Default: .arivu_data/arivu.db (relative to working directory)
ARIVU_SQLITE_PATH=

# Redis connection URL (only used when ARIVU_MEMORY_BACKEND=redis).
ARIVU_REDIS_URL=redis://localhost:6379/0


# ── MCP Server — Database Connection ─────────────────────────────────────────
# Used when exposing your database to AI editors (Cursor, Windsurf) via MCP.
# Supported dialects: postgresql | mysql | sqlite | snowflake | databricks
ARIVU_DB_DIALECT=postgresql
ARIVU_DB_MODE=user

# Standard RDBMS (PostgreSQL / MySQL)
ARIVU_DB_HOST=localhost
ARIVU_DB_PORT=5432
ARIVU_DB_USER=
ARIVU_DB_PASSWORD=
ARIVU_DB_NAME=

# SQLite (only ARIVU_DB_NAME is used — set it to the path of your .db file)
# ARIVU_DB_NAME=/path/to/your/database.db

# Snowflake (set these in addition to ARIVU_DB_USER, ARIVU_DB_PASSWORD, ARIVU_DB_NAME)
ARIVU_SNOWFLAKE_ACCOUNT=
ARIVU_SNOWFLAKE_WAREHOUSE=
ARIVU_SNOWFLAKE_ROLE=

# Databricks (set these in addition to ARIVU_DB_HOST)
ARIVU_DATABRICKS_HTTP_PATH=
ARIVU_DATABRICKS_TOKEN=
ARIVU_DATABRICKS_CATALOG=main
ARIVU_DATABRICKS_SCHEMA=default


# ── Telegram Integration ──────────────────────────────────────────────────────
# Required to deploy Arivu as a Telegram bot.
# Get token: talk to @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=


# ── WhatsApp Integration (via Twilio) ─────────────────────────────────────────
# Required to deploy Arivu as a WhatsApp bot.
# Sign up at: https://twilio.com → enable WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to 1 to skip Twilio signature validation (ONLY for local development with ngrok)
TWILIO_SKIP_VALIDATION=0


# ── Slack Integration ─────────────────────────────────────────────────────────
# Required to deploy Arivu as a Slack bot.
# Create an app at: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=


# ── Discord Integration ───────────────────────────────────────────────────────
# Required to deploy Arivu as a Discord bot.
# Create a bot at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=


# ── REST API Integration ──────────────────────────────────────────────────────
# Optional API key to secure the Arivu REST API (/query, /approve, /feedback endpoints).
# Leave blank to run without authentication (not recommended in production).
ARIVU_API_KEY=


# ── Dashboard Backend Rate Limits ─────────────────────────────────────────────
# Controls request rate limiting per IP for dashboard API endpoints.
# Format: "N/period" where period is second | minute | hour
ARIVU_CHAT_RATE_LIMIT=30/minute
ARIVU_SUGGESTIONS_RATE_LIMIT=20/minute
ARIVU_VISUALIZE_RATE_LIMIT=20/minute


# ── Email / SMTP (for Automations) ────────────────────────────────────────────
# Used by the Automations feature to dispatch scheduled email reports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=arivu@yourdomain.com
